# Copy to .env and fill in the empty values. .env is gitignored; never commit secrets.

# --- Database (docker-compose.yml + backend) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=arunika
# Owner role: schema setup and seeding only. The agent will use a separate read-only role (Phase 2).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Safety layer (Phase 2) ---
# Password of the agent's read-only database role (created by `poe db-load`).
NLQ_READER_PASSWORD=
# Hex key (>= 32 bytes) that signs the per-request region scope checked by row-level security.
RLS_SIGNING_KEY=

# --- LLM (Phase 3+) ---
# fake = keyless (tests, CI, demo). anthropic | openai = live; needs that provider's key and costs money.
LLM_PROVIDER=fake
LLM_MODEL=claude-haiku-5-5
# Optional: low | medium | high | xhigh | max (empty = model default)
LLM_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent (Phase 4; optional, defaults shown) ---
# Budget per run: the run stops cleanly (status "partial") when one is exceeded.
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_TOKENS=60000
AGENT_MAX_COST_USD=0.05
AGENT_MAX_SECONDS=60
AGENT_MAX_REPAIRS=3
# Local embedding model for retrieval (fastembed, keyless) and where it is cached.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=.cache/fastembed
# JSONL run store (gitignored)
RUNS_DIR=runs

# --- API (Phase 5) ---
# Password of the API's write-only role for the run store (created by `poe app-setup`).
APP_WRITER_PASSWORD=
# Signs the session cookie (JWT). At least 32 characters.
JWT_SECRET=
# Passwords of the seeded demo users analyst@demo and manager.jakarta@demo.
DEMO_ANALYST_PASSWORD=
DEMO_MANAGER_PASSWORD=
SESSION_HOURS=8
# true when the API is served over HTTPS (the cookie gets the Secure flag).
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=10
# Live (paid) spend allowed per day, all users together; reaching it returns 429.
DAILY_BUDGET_USD=1.00
# Kill switch: with a paid provider configured, false makes /api/ask return 503.
LIVE_MODE_ENABLED=false
