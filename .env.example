# Copy to .env and fill in the empty values. .env is gitignored; never commit secrets.

# --- Database (docker-compose.yml + backend) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=arunika
# Owner role: schema setup and seeding only. The agent will use a separate read-only role (Phase 2).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Safety layer (Phase 2) ---
# Password of the agent's read-only database role (created by `poe db-load`).
NLQ_READER_PASSWORD=
# Hex key (>= 32 bytes) that signs the per-request region scope checked by row-level security.
RLS_SIGNING_KEY=
