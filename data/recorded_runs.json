   "question": "What was net revenue by sales channel in Q1 2026?",
   "lang": "en",
   "role": "analyst",
   "status": "answered",
   "answer": "Net revenue by sales channel for Q1 2026, interpreted as calendar Q1 rather than fiscal Q1, was IDR 3.88B for app, IDR 2.26B for marketplace, IDR 9.29B for store, and IDR 2.41B for website.",
   "assumptions": [
    "Interpreted “Q1 2026” as calendar Q1 (January–March 2026), not fiscal Q1."
   ],
   "caveats": [],
   "sql": "WITH order_net AS (SELECT o.order_id, o.channel_id, SUM(oi.quantity * oi.unit_price_idr - oi.discount_idr) AS line_net FROM analytics.fact_orders AS o JOIN analytics.fact_order_items AS oi ON oi.order_id = o.order_id WHERE o.status <> 'cancelled' AND CAST((o.ordered_at AT TIME ZONE 'Asia/Jakarta') AS DATE) BETWEEN CAST('2026-01-01' AS DATE) AND CAST('2026-03-31' AS DATE) GROUP BY o.order_id, o.channel_id), refunds AS (SELECT r.order_id, SUM(r.refund_amount_idr) AS refunded FROM analytics.fact_returns AS r GROUP BY r.order_id) SELECT c.channel_code AS sales_channel, SUM(n.line_net - COALESCE(r.refunded, 0)) AS net_revenue_idr FROM order_net AS n JOIN analytics.dim_channel AS c ON c.channel_id = n.channel_id LEFT JOIN refunds AS r ON r.order_id = n.order_id GROUP BY c.channel_code ORDER BY c.channel_code",
   "columns": [
    "sales_channel",
    "net_revenue_idr"
   ],
   "rows": [
